  "audit_source": "\"\"\"Read-only recheck of the revised paper and its stored evidence; no provider calls.\"\"\"\nfrom pathlib import Path\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport random\nimport sys\nimport csv\nimport zipfile\n\nimport fitz\nimport yaml\nfrom PIL import Image, ImageDraw\n\nsys.stdout.reconfigure(encoding=\"utf-8\")\nROOT = Path(__file__).resolve().parents[2]\nOUT = Path(__file__).resolve().parent\n\n\ndef load_module(name, relative):\n    spec = importlib.util.spec_from_file_location(name, ROOT / relative)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef rows(path):\n    return [json.loads(line) for line in path.read_text(encoding=\"utf-8\").splitlines() if line.strip()]\n\n\npaper = OUT / \"reviewed-paper.pdf\"\ndoc = fitz.open(paper)\naudit = {\"run_id\": \"acl-recheck-2026-10-02-81f589f7bbcc\", \"pdf\": {\n    \"path\": str(paper.relative_to(ROOT)), \"sha256\": hashlib.sha256(paper.read_bytes()).hexdigest(),\n    \"pages\": len(doc), \"bytes\": paper.stat().st_size, \"metadata\": doc.metadata},\n    \"scope\": \"Independent deterministic checks of stored evidence; no new labels or model runs.\"}\n\nfonts = {}\nfor page_no, page in enumerate(doc, 1):\n    sizes = collections.Counter()\n    examples = []\n    for block in page.get_text(\"dict\")[\"blocks\"]:\n        for line in block.get(\"lines\", []):\n            for span in line[\"spans\"]:\n                if span[\"text\"].strip():\n                    sizes[round(span[\"size\"], 3)] += len(span[\"text\"])\n                    if span[\"size\"] < 7.1 and len(span[\"text\"].strip()) > 8:\n                        examples.append({\"text\": span[\"text\"], \"size\": span[\"size\"], \"bbox\": span[\"bbox\"]})\n    fonts[str(page_no)] = {\"sizes_char_counts\": dict(sorted(sizes.items())), \"small_text_examples\": examples[:12]}\n    if page_no in (1, 5, 7, 16):\n        page.get_pixmap(matrix=fitz.Matrix(1.6, 1.6)).save(OUT / f\"detail-{page_no:02d}.png\")\naudit[\"fonts\"] = fonts\nfor start in range(1, len(doc) + 1, 6):\n    sheet = Image.new(\"RGB\", (1080, 3 * 785), \"#dddddd\")\n    draw = ImageDraw.Draw(sheet)\n    for idx, no in enumerate(range(start, min(start + 6, len(doc) + 1))):\n        im = Image.open(OUT / f\"page-{no:02d}.png\").convert(\"RGB\")\n        im.thumbnail((530, 755))\n        x, y = (idx % 2) * 540, (idx // 2) * 785\n        sheet.paste(im, (x, y + 22))\n        draw.text((x + 8, y + 4), f\"Page {no}\", fill=\"black\")\n    sheet.save(OUT / f\"contact-{start:02d}.png\")\n\npn = load_module(\"review_paper_numbers\", \"scripts/eval/paper_numbers.py\")\nobs = []\nfor p in sorted((ROOT / \"docs/eval/observations\").glob(\"*.jsonl\")):\n    obs.extend(rows(p))\nm8 = pn.compute([o for o in obs if o[\"metric\"] == \"M8\"], reps=2000, seed=0)\nreported = {r[\"key\"]: r for r in json.loads((ROOT / \"docs/eval/paper_numbers.json\").read_text())[\"results\"]}\naudit[\"m8_recomputed\"] = [r for r in m8 if \"-avg-\" in r[\"key\"]]\naudit[\"m8_matches_reported\"] = all(r[\"value\"] == reported[r[\"key\"]][\"value\"] and r[\"ci95\"] == reported[r[\"key\"]][\"ci95\"] for r in audit[\"m8_recomputed\"])\n\n# Intersect actual entity-cutoff cells before calculating a paired recall comparison.\na = [o for o in obs if o[\"metric\"] == \"M1\" and o[\"system\"] == \"B5\"]\nb = [o for o in obs if o[\"metric\"] == \"M1\" and o[\"system\"] == \"B2\"]\ncells_a = {(o[\"character\"], o[\"cutoff\"]) for o in a}\ncells_b = {(o[\"character\"], o[\"cutoff\"]) for o in b}\nshared = cells_a & cells_b\nmatched = [o for o in a + b if (o[\"character\"], o[\"cutoff\"]) in shared]\ncorrected = pn.compute(matched, reps=2000, seed=0, pairs=[(\"B5\", \"B2\")])\nkey = \"M1-anne-avg-B5-minus-B2\"\naudit[\"paired_recall\"] = {\"reported\": reported[key], \"common_entity_cutoff\": next(r for r in corrected if r[\"key\"] == key),\n    \"B5_cutoffs\": sorted({o[\"cutoff\"] for o in a}), \"B2_cutoffs\": sorted({o[\"cutoff\"] for o in b}),\n    \"common_cutoffs\": sorted({t for _, t in shared}), \"B5_rows_excluded\": len(a) - sum(o[\"system\"] == \"B5\" for o in matched)}\n\ncalls = []\nexcluded = \"20260928T190130-baseline-b3-v2\"\nfor p in sorted((ROOT / \"data/anne@b3/_runs\").glob(\"*baseline-b3*/calls.jsonl\")):\n    if p.parent.name != excluded:\n        calls.extend(r for r in rows(p) if r.get(\"stage\") == \"baseline_lightrag\" and not r.get(\"error\"))\nunique = {r[\"cache_key\"]: r for r in calls}\ntin = sum(r[\"in_tokens\"] for r in unique.values())\ntout = sum(r[\"out_tokens\"] for r in unique.values())\npagecost = json.loads((ROOT / \"docs/eval/cost/anne@b3_final.json\").read_text())[\"by_stage\"][\"baseline_page\"][\"cost_usd\"]\naudit[\"B3_cost\"] = {\"index_unique_calls\": len(unique), \"index_in_tokens\": tin, \"index_out_tokens\": tout,\n    \"index_usd_price_0_75_3_75\": (tin * .75 + tout * 3.75) / 1000000,\n    \"page_cost_usd\": pagecost, \"total_usd\": pagecost + (tin * .75 + tout * 3.75) / 1000000,\n    \"excluded_run\": excluded}\n\ngold = yaml.safe_load((ROOT / \"docs/eval/parametric/anne.yaml\").read_text(encoding=\"utf-8\"))\nlater = [(ch, f) for ch, e in gold[\"characters\"].items() for f in e[\"facts\"] if 1 < int(f[\"evidence\"].split(\":\")[0][1:]) <= 5]\nseeds = yaml.safe_load((ROOT / \"docs/eval/m4_seeded/anne_seeds.yaml\").read_text(encoding=\"utf-8\"))[\"seeds\"]\nby_claim = collections.defaultdict(list)\nfor (ch, f), seed in zip(later, seeds):\n    assert f[\"claim\"].startswith(seed[\"c\"])\n    by_claim[f[\"claim\"]].append({\"character\": ch, \"paraphrase\": seed[\"p\"], \"oblique\": seed[\"o\"]})\naudit[\"seed_fixture\"] = {\"fact_entries\": len(later), \"unique_claim_strings\": len(by_claim),\n    \"duplicate_claims\": {c: entries for c, entries in by_claim.items() if len(entries) > 1},\n    \"examples_needing_semantic_validation\": [{\"gold\": f[\"claim\"], \"character\": ch, **s} for (ch, f), s in zip(later, seeds)\n        if s[\"c\"] in (\"Carl gets a sore throat\", \"Diana marries Fred\", \"Una Meredith is ten\")]}\nseed_mod = load_module(\"review_seed_test\", \"scripts/eval/m4_seed_test.py\")\nseed_mod.paths.set_active_series(\"anne\")\nseed_by_claim = {f[\"claim\"]: s for (ch, f), s in zip(later, seeds)}\ncounts = collections.defaultdict(collections.Counter)\nfor t in range(1, 5):\n    for _, name, names, name_words, _, claim, _, content, kws in seed_mod.m4_tree.frames(\"anne\", t, 5):\n        for label, field, subject, own_page in seed_mod.VARIANTS:\n            s = seed_by_claim[claim]\n            text = claim if field == \"claim\" else s[field].replace(\"{N}\", name if subject == \"name\" else \"They\")\n            kind = seed_mod.m4_tree.classify(text, own_page, names, name_words, content, kws)\n            counts[label][\"total\"] += 1\n            counts[label][\"found\"] += bool(kind)\naudit[\"seed_classifier_recomputed\"] = {k: dict(v) for k, v in counts.items()}\nstored_seeds = json.loads((ROOT / \"docs/eval/m4_seeded/anne_sensitivity.json\").read_text(encoding=\"utf-8\"))\naudit[\"seed_classifier_matches_stored\"] = all(v[\"found\"] == stored_seeds[\"variants\"][k][\"found\"] and v[\"total\"] == stored_seeds[\"variants\"][k][\"total\"] for k, v in counts.items())\n\nhuman = ROOT / \"docs/eval/human\"\nk = json.loads((human / \"key.json\").read_text(encoding=\"utf-8\"))\naudit[\"human_package\"] = {\"part_counts\": dict(collections.Counter(i[0] for i in k)),\n    \"B_agent_verdicts\": dict(collections.Counter(v[\"agent\"] for i, v in k.items() if i.startswith(\"B\"))),\n    \"returned_reader_files\": [str(p.relative_to(ROOT)) for pattern in (\"A_answers_*.csv\", \"B_answers_*.csv\", \"*_adjudicated.csv\") for p in human.glob(pattern)],\n    \"older_blind_sheet_items\": len(json.loads((ROOT / \"docs/eval/annotation/anne_m3_blind_key.json\").read_text(encoding=\"utf-8\")))}\ntruncated, pair_disagreements = [], []\nfor item, v in k.items():\n    if not item.startswith(\"A\"):\n        continue\n    source = ROOT / \"docs/eval/precision\" / f\"{v['series']}_v{v['t']}_all.jsonl\"\n    r = rows(source)[v[\"row\"]]\n    evidence = r.get(\"evidence\") or []\n    if len(evidence) > 6:\n        truncated.append({\"item\": item, \"system\": v[\"system\"], \"raw_citation_count\": len(evidence)})\n    if r[\"page\"].startswith(\"relationships/\") and v[\"agent_atom\"] == \"supported\" and v[\"agent_page\"] != \"supported\":\n        pair_disagreements.append({\"item\": item, \"page_label\": v[\"agent_page\"], \"atom_label\": v[\"agent_atom\"]})\naudit[\"human_package\"][\"citation_lists_above_six\"] = truncated\naudit[\"human_package\"][\"pair_atom_vs_page_disagreements\"] = pair_disagreements\nscorer = load_module(\"review_human_scorer\", \"docs/eval/human/score.py\")\nscorer.HERE = OUT / \"scorer-diagnostic\"\nscorer.HERE.mkdir(exist_ok=True)\nwith (scorer.HERE / \"A_answers_diagnostic.csv\").open(\"w\", encoding=\"utf-8\", newline=\"\") as f:\n    writer = csv.writer(f)\n    writer.writerow([\"item\", \"support\", \"pair\", \"citation\", \"comment\"])\n    writer.writerow([\"A001\", \"cannot tell\", \"n-a\", \"yes\", \"diagnostic fixture, not a human response\"])\n    writer.writerow([\"A002\", \"\", \"n-a\", \"yes\", \"diagnostic fixture, not a human response\"])\nloaded = scorer.load(\"A\")[\"diagnostic\"]\naudit[\"human_package\"][\"scorer_diagnostic\"] = {i: {\"support_input\": r[0], \"kept_by_loader\": True,\n    \"support_binary_as_in_main\": int(r[0] == \"yes\")} for i, r in loaded.items()}\n\nrelease = ROOT / \"dist/narrativewiki-anonymous-release.zip\"\nwith zipfile.ZipFile(release) as z:\n    ns = z.namelist()\n    audit[\"release_archive\"] = {\"path\": str(release.relative_to(ROOT)), \"sha256\": hashlib.sha256(release.read_bytes()).hexdigest(),\n        \"bytes\": release.stat().st_size, \"entries\": len(ns),\n        \"pdf_sha256\": hashlib.sha256(z.read(\"NarrativeWiki-paper.pdf\")).hexdigest(),\n        \"contains_reviewed_pdf\": z.read(\"NarrativeWiki-paper.pdf\") == paper.read_bytes(),\n        \"wikifiles\": sum(n.startswith(\"wikis/\") for n in ns),\n        \"has_key_results\": \"docs/eval/paper_numbers.json\" in ns,\n        \"has_ledger\": \"docs/MEASUREMENTS.md\" in ns,\n        \"contains_raw_call_logs\": any(n.endswith(\"calls.jsonl\") for n in ns)}\n\nsources = [\"scripts/eval/paper_numbers.py\", \"scripts/eval/m4_seed_test.py\", \"docs/eval/m4_seeded/anne_seeds.yaml\",\n    \"docs/eval/human/make_package.py\", \"docs/eval/human/score.py\", \"docs/eval/human/INSTRUCTIONS.md\", \"docs/eval/human/key.json\", \"docs/eval/paper_numbers.json\"]\naudit[\"source_hashes\"] = {p: hashlib.sha256((ROOT / p).read_bytes()).hexdigest() for p in sources}\naudit[\"reproduction_commands\"] = {\"full_audit\": \"python dist/reviewer-2026-10-02-r2/audit.py\",\n    \"paired_cell_filter\": \"Intersect (character, cutoff) keys in M1 B5/B2 observation rows before paper_numbers.compute(..., reps=2000, seed=0, pairs=[('B5','B2')]).\",\n    \"human_scoring_rule\": \"Inspect docs/eval/human/score.py load/report/main: blank relevant cells and cannot-tell answers currently map to negative binary values.\"}\naudit[\"audit_source\"] = Path(__file__).read_text(encoding=\"utf-8\")\n(ROOT / \"docs/eval/paper_review_2026-10-02_r2.json\").write_text(json.dumps(audit, ensure_ascii=False, indent=2) + \"\\n\", encoding=\"utf-8\")\nprint(json.dumps({k: audit[k] for k in (\"run_id\", \"m8_matches_reported\", \"paired_recall\", \"B3_cost\", \"seed_classifier_recomputed\", \"seed_classifier_matches_stored\", \"human_package\", \"release_archive\")}, ensure_ascii=False, indent=2))\n"
}
